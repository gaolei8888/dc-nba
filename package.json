{
  "name": "dc-nba",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NBA 球队/球员数据与 2026-27 赛季比赛预测应用",
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "backtest": "node scripts/backtest.mjs",
    "backtest:roster": "node scripts/roster-backtest.mjs",
    "test": "node --test tests/*.test.mjs",
    "backup": "node scripts/backup-db.mjs",
    "check": "node scripts/check-jsx.mjs",
    "server": "node server/index.mjs",
    "dev": "concurrently -n server,web -c cyan,magenta \"node --watch server/index.mjs\" \"vite --config web/vite.config.js\"",
    "build": "node scripts/check-jsx.mjs && vite build --config web/vite.config.js",
    "start": "npm run build && node server/index.mjs",
    "odds:history": "node scripts/odds-history.mjs",
    "dataset": "node scripts/build-dataset.mjs",
    "impact:fetch": "node scripts/impact-history.mjs",
    "impact:fit": "node scripts/fit-impact.mjs",
    "check:data": "node scripts/check-data.mjs",
    "lineups:fetch": "node scripts/lineups-history.mjs",
    "pbp:fetch": "node scripts/pbp-history.mjs",
    "rapm:lab": "node scripts/rapm-lab.mjs",
    "impact:lab": "node scripts/impact-lab.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
